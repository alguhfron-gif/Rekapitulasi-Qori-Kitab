rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Presensi MTK Musyawarah collections
    match /peserta/{pesertaId} {
      allow read, write: if true;
    }
    match /attendance_records/{recordId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
